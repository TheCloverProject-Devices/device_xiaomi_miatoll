// Rule to merge GoogleCamera.apk parts into a single APK
genrule {
    name: "merge_GoogleCamera",
    srcs: [
        "GoogleCamera.*", // Matches all files ending with .part
    ],
    out: ["GoogleCamera.apk"],
    cmd: "cat $(in) > $(out)",
}

// Import GoogleCamera as an Android prebuilt application
android_app_import {
    name: "GoogleCamera",
    apk: ":merge_GoogleCamera", // Reference the output of the genrule
    overrides: [
        "Snap",
        "Camera2",
        "Aperture",
        "GCamGOPrebuilt-V3",
    ],
    owner: "google",
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}